{
  "schema_version": "1",
  "_doc": "D021a + D022 classification config. Rules are tried in order; first match wins. Excludes are checked before rules. Overrides (by exact path) take precedence over everything.",
  "rules": [
    {
      "_comment": "D022: plugins/ is the canonical home for shipped plugins. Drops the lazysite- prefix; installed under DOCROOT/../plugins/ to match manager-api's @CANDIDATES search path.",
      "pattern": "^plugins/(.+\\.pl)$",
      "install_to": "{DOCROOT}/../plugins/$1",
      "bucket": "code"
    },
    {
      "_comment": "Core CGI scripts stay at repo root with the lazysite- prefix. processor, auth, manager-api, dav, mcp, oauth are explicitly enumerated so a future stray lazysite-*.pl at root won't get silently installed to cgi-bin.",
      "pattern": "^lazysite-(processor|auth|manager-api|dav|mcp|oauth)\\.pl$",
      "install_to": "{CGIBIN}/$0",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-users\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-users.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-domains\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-domains.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-site\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-site.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-server\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-server.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-bundle-apply\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-bundle-apply.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-check\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-check.pl",
      "bucket": "code"
    },
    {
      "pattern": "^tools/lazysite-fix-perms\\.pl$",
      "install_to": "{DOCROOT}/../tools/lazysite-fix-perms.pl",
      "bucket": "code"
    },
    {
      "_comment": "SM079: shared Lazysite::* modules. Installed beside tools/ and plugins/ at DOCROOT/../lib; the modular scripts add it to @INC via a relative use-lib bootstrap. The processor does not depend on it.",
      "pattern": "^lib/(Lazysite/.+\\.pm)$",
      "install_to": "{DOCROOT}/../lib/$1",
      "bucket": "code"
    },
    {
      "pattern": "^tools/build-static\\.sh$",
      "install_to": "{DOCROOT}/../tools/build-static.sh",
      "bucket": "code"
    },
    {
      "_comment": "Public shared assets served at /assets/ (docroot root, no auth) - e.g. the bundled qrcode.js used by the 2FA QR and the ::: qr content component. Code bucket so upgrades refresh them.",
      "pattern": "^starter/assets/(.+)$",
      "install_to": "{DOCROOT}/assets/$1",
      "bucket": "code"
    },
    {
      "_comment": "Built-in content components (::: qr, ...) available on any layout via the templates fallback in the processor.",
      "pattern": "^starter/lazysite/templates/components/(.+)$",
      "install_to": "{DOCROOT}/lazysite/templates/components/$1",
      "bucket": "code"
    },
    {
      "_comment": "SM201: engine-required system pages (login/claim/402/403/404) served with a fallback - a content-root or docroot-root copy overrides, else this protected default. Code bucket (refreshed every upgrade, DAV-blocklisted so an agent cannot delete it). Precedes the general starter/*.md seed rule so it is NOT seeded as an editable root page.",
      "pattern": "^starter/lazysite/templates/system/(.+)$",
      "install_to": "{DOCROOT}/lazysite/templates/system/$1",
      "bucket": "code"
    },
    {
      "pattern": "^starter/manager/(.+)$",
      "install_to": "{DOCROOT}/manager/$1",
      "bucket": "code"
    },
    {
      "_comment": "Manager CSS/assets must be web-served at /manager/assets/ (the /lazysite/ tree is Apache-denied). Ship them straight there via the manifest - code bucket, so an upgrade always refreshes them - instead of the old install.pl copy hack, which left a stale manager.css on upgrade. This rule precedes the general lazysite/manager rule (first match wins).",
      "pattern": "^starter/lazysite/manager/assets/(.+)$",
      "install_to": "{DOCROOT}/manager/assets/$1",
      "bucket": "code"
    },
    {
      "_comment": "D013: manager UI template lives outside both layouts/ and themes/. Manager is internal plumbing, not a themeable layout. (assets/ handled by the rule above.)",
      "pattern": "^starter/lazysite/manager/(.+)$",
      "install_to": "{DOCROOT}/lazysite/manager/$1",
      "bucket": "code"
    },
    {
      "_comment": "D022: registries source path now matches install destination. One rule replaces the previous rule-pair.",
      "pattern": "^starter/lazysite/templates/registries/(.+)$",
      "install_to": "{DOCROOT}/lazysite/templates/registries/$1",
      "bucket": "seed"
    },
    {
      "pattern": "^starter/lazysite/forms/(.+)\\.conf\\.example$",
      "install_to": "{DOCROOT}/lazysite/forms/$1.conf",
      "bucket": "seed"
    },
    {
      "pattern": "^starter/lazysite/auth/(.+)\\.example$",
      "install_to": "{DOCROOT}/lazysite/auth/$1.example",
      "bucket": "seed"
    },
    {
      "pattern": "^starter/lazysite\\.conf\\.example$",
      "install_to": "{DOCROOT}/lazysite/lazysite.conf.example",
      "bucket": "seed"
    },
    {
      "pattern": "^starter/nav\\.conf\\.example$",
      "install_to": "{DOCROOT}/lazysite/nav.conf.example",
      "bucket": "seed"
    },
    {
      "pattern": "^starter/docs/(.+)$",
      "install_to": "{DOCROOT}/docs/$1",
      "bucket": "code"
    },
    {
      "pattern": "^starter/(\\.well-known/.+)$",
      "install_to": "{DOCROOT}/$1",
      "bucket": "code"
    },
    {
      "pattern": "^starter/(.+\\.md)$",
      "install_to": "{DOCROOT}/$1",
      "bucket": "seed"
    },
    {
      "pattern": "^installers/hestia/(.+)$",
      "install_to": null,
      "bucket": "code"
    },
    {
      "_comment": "SM139 glue-deb vhost templates (lazysite-apache / lazysite-nginx): released with the tarball, never installed into a site tree.",
      "pattern": "^installers/(apache|nginx)/(.+)$",
      "install_to": null,
      "bucket": "code"
    },
    {
      "pattern": "^install\\.(sh|pl)$",
      "install_to": null,
      "bucket": "code"
    },
    {
      "_comment": "Root-of-tarball docs including UPGRADE.md from 0.2.0 onwards.",
      "pattern": "^(LICENSE|COPYRIGHT|THIRD-PARTY-NOTICES\\.md|README\\.md|SECURITY\\.md|UPGRADE\\.md)$",
      "install_to": null,
      "bucket": "code"
    }
  ],
  "exclude": [
    "^Makefile$",
    "^NEXT_VERSION$",
    "^VERSION$",
    "^\\.git(/|$)",
    "^\\.github/",
    "^\\.gitignore$",
    "^\\.perlcriticrc$",
    "^\\.perltidyrc$",
    "^tools/tidy-check\\.pl$",
    "^tools/backlog\\.pl$",
    "^\\.release-notes\\.md$",
    "^\\.release-notes\\.md\\.new$",
    "^\\.release-prep\\.sh$",
    "^\\.rsyncignore$",
    "^dist/",
    "^cover_db/",
    "^inbox/",
    "^docs/adr/",
    "^docs/architecture/",
    "^docs/development\\.md$",
    "^docs/feature-requests/",
    "^docs/reference/",
    "^docs/review/",
    "^security/",
    "^docs/(USER|DEVELOPER|IMPLEMENTOR|OPERATOR|POLICY|FEATURES|SECURITY|ACCESSIBILITY|RELIABILITY|DECLARATION-OF-CONFORMITY|MANUAL-CHECKS)\\.md$",
    "^docs/.*\\.pdf$",
    "^CHANGELOG\\.md$",
    "^reported-issues\\.md$",
    "^\\.nonfunctional-report\\.md$",
    "^\\.commit-message\\.md$",
    "^CLAUDE\\.md$",
    "^starter/lazysite/cache/",
    "^starter/lazysite/logs/",
    "^starter/lazysite/stats/",
    "^starter/lazysite/auth/users$",
    "^starter/lazysite/auth/groups$",
    "^starter/lazysite/auth/\\.",
    "^starter/feed\\.(atom|rss)$",
    "^starter/llms\\.txt$",
    "^starter/sitemap\\.xml$",
    "^installers/docker/",
    "^release-manifest\\.json$",
    "^sbom\\.json$",
    "^tools/commit\\.sh$",
    "^tools/release\\.sh$",
    "^tools/build-deb\\.sh$",
    "^tools/lazysite-cli\\.pl$",
    "^tools/lazysite-pool\\.pl$",
    "^tools/lazysite-hestia-domain\\.pl$",
    "^tools/lazysite-apache-vhost\\.pl$",
    "^tools/lazysite-nginx-vhost\\.pl$",
    "^debian/",
    "^starter/.*\\.html$",
    "^starter/lazysite/auth/\\.gitkeep$",
    "^starter/lazysite/forms/contact\\.conf$",
    "^starter/lazysite/forms/handlers\\.conf$",
    "^starter/lazysite/lazysite\\.conf$",
    "^starter/lazysite/nav\\.conf$",
    "^t/",
    "^tmp/",
    "^cover_db/",
    "^tools/build-manifest\\.pl$",
    "^tools/manifest-to-sbom\\.pl$",
    "^tools/bump-version\\.pl$",
    "^tools/bench\\.pl$",
    "^tools/coverage\\.sh$",
    "^tools/gen-host-deps\\.pl$",
    "^tools/gen-capability-docs\\.pl$",
    "^tools/gen-manpages\\.pl$",
    "^man/",
    "^website/"
  ],
  "overrides": [],
  "runtime_paths": [
    {
      "path": "{DOCROOT}/lazysite/auth",
      "mode": "2770",
      "purpose": "credentials, session secret, ACLs, consume lock, rate-limit DB - setgid + group-writable by the web user (www-data), no world access"
    },
    {
      "path": "{DOCROOT}/lazysite/cache",
      "mode": "2775",
      "purpose": "rendered HTML cache - setgid + group-writable by www-data (the CGI writes it), world-readable (Apache serves it)"
    },
    {
      "path": "{DOCROOT}/lazysite/logs",
      "mode": "2775",
      "purpose": "application log output - setgid + group-writable by www-data"
    },
    {
      "path": "{DOCROOT}/lazysite/stats",
      "mode": "2775",
      "purpose": "SM213 durable per-day visitor-stats rollups (aggregates only) - setgid + group-writable by www-data (the stats plugin writes it), not served publicly (under the protected lazysite/ tree)"
    },
    {
      "path": "{DOCROOT}/lazysite/manager/locks",
      "mode": "2775",
      "purpose": "per-file edit locks - setgid + group-writable by www-data"
    },
    {
      "path": "{DOCROOT}/../plugins",
      "mode": "0755",
      "purpose": "plugin scripts (D022)"
    },
    {
      "path": "{DOCROOT}/lazysite/layouts",
      "mode": "2775",
      "purpose": "layouts + nested themes (D013) - setgid + group-writable by www-data (manage_layouts installs over the API)"
    },
    {
      "path": "{DOCROOT}/lazysite-assets",
      "mode": "2775",
      "purpose": "web-served theme assets (D013 nested under LAYOUT/THEME/) - setgid + group-writable by www-data (written on layout install)"
    }
  ]
}
