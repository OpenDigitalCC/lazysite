<!DOCTYPE html>
<html lang="[% page_lang || 'en' %]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>[% page_title %][% IF site_name %] - [% site_name %][% END %]</title>
  <!-- SM698: the bundled faces. This link was MISSING: the sheets carried a
       comment saying to load it and nothing did, so Barlow never arrived and
       every style fell back to the system font - which is why `modern` and
       `accessible` did not look like the design they were drawn from. It goes
       BEFORE the manager sheet so @font-face is known when the first rule that
       names Barlow is applied. -->
  <link rel="stylesheet" href="/manager/assets/fonts.css?v=[% lazysite_version %]">
  <link rel="stylesheet" href="/manager/assets/manager-[% manager_style %].css?v=[% lazysite_version %]">
  <script>
  // SM109 phase 6: set the theme before first paint (no flash). Saved choice wins,
  // else follow the OS preference.
  (function(){
    try {
      var t = localStorage.getItem('mg-theme');
      if (t !== 'dark' && t !== 'light') {
        t = (window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
      }
      document.documentElement.setAttribute('data-theme', t);
    } catch (e) {}
  })();
  // SM-DS1: the drawer. `data-nav-open` on .mg-shell is what the sheet keys
  // off; nothing else needs to know it is open. Escape closes it, because a
  // drawer that covers the page and can only be dismissed by finding the scrim
  // is a trap for anyone on a keyboard.
  window.mgToggleNav = function (want) {
    var shell = document.querySelector('.mg-shell');
    if (!shell) return;
    var open = (want === undefined) ? !shell.hasAttribute('data-nav-open') : !!want;
    if (open) { shell.setAttribute('data-nav-open', ''); }
    else      { shell.removeAttribute('data-nav-open'); }
    var b = document.querySelector('.mg-nav-burger');
    if (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); }
  };
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { window.mgToggleNav(0); }
  });

  window.mgToggleTheme = function(){
    var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('mg-theme', next); } catch (e) {}
  };

  // SM154 (P3): a domain-bound editor's own content root and domain, so the
  // file browser can root there (server-side confinement in the manager-api
  // enforces it regardless; this just gives a coherent starting view). Empty
  // for an operator (unbound). Values are charset-constrained server-side
  // (a normalised path / a validated hostname), safe to inline in a JS string.
  window.LAZYSITE_SCOPE_ROOT  = '[% scope_root %]';
  window.LAZYSITE_HOME_DOMAIN = '[% home_domain %]';
  // SM157: every content root the user is scoped to (comma list), for the file
  // browser's multi-domain switcher. Same charset guarantee as scope_root.
  window.LAZYSITE_DAV_SCOPES  = '[% dav_scopes %]';

  // M-1: manager CSRF wrapper. Must run BEFORE any script inside <main>
  // that calls fetch(), otherwise page-onload calls (loadUsers,
  // loadSiteSettings, loadCache, etc.) will capture the original
  // window.fetch reference at call time and bypass the wrapper - so
  // their POSTs go out without X-CSRF-Token and the server rejects
  // them. Placing this in <head> means window.fetch is replaced before
  // the HTML parser has even reached <body>.
  //
  // The wrapper itself kicks off an asynchronous csrf-token fetch and
  // attaches the resolved token as X-CSRF-Token on every POST to the
  // manager API. Page scripts do not need to await anything; each POST
  // waits for lazysiteCsrfReady() internally.
  // Global warning bar helpers. Pages call mgShowWarning(msg, isError)
  // on any {ok:0} or network failure, and mgClearWarning() on success.
  window.mgShowWarning = function(msg, isError) {
    var bar = document.getElementById('mg-warning-bar');
    var txt = document.getElementById('mg-warning-bar-msg');
    if (!bar || !txt) return;
    txt.textContent = msg || '';
    bar.className = 'mg-warning-bar' + (isError ? ' mg-warning-error' : '');
    bar.style.display = 'flex';
  };
  window.mgClearWarning = function() {
    var bar = document.getElementById('mg-warning-bar');
    if (bar) bar.style.display = 'none';
  };

  // SM109 phase 2: toast notifications + a styled confirm/prompt modal, replacing
  // the warning bar and the native confirm()/prompt(). mgShowWarning and the pages'
  // showStatus route to a toast, so existing feedback call sites need no change.
  window.mgToast = function(msg, kind) {
    var host = document.getElementById('mg-toasts');
    if (!host) { host = document.createElement('div'); host.id = 'mg-toasts'; document.body.appendChild(host); }
    var t = document.createElement('div');
    t.className = 'mg-toast' + (kind ? ' mg-toast-' + kind : '');
    t.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    t.textContent = msg || '';
    host.appendChild(t);
    requestAnimationFrame(function(){ t.classList.add('mg-toast-in'); });
    var ttl = (kind === 'error') ? 6000 : 3500;
    setTimeout(function(){
      t.classList.remove('mg-toast-in');
      setTimeout(function(){ if (t.parentNode) t.parentNode.removeChild(t); }, 250);
    }, ttl);
  };
  window.mgShowWarning  = function(msg, isError){ window.mgToast(msg, isError ? 'error' : 'success'); };
  window.mgClearWarning = function(){};
  window.showStatus     = function(msg, isError){ window.mgToast(msg, isError ? 'error' : 'success'); };

  // Promise-based modal: resolves true/false (confirm) or string/null (prompt).
  function mgModal(opts) {
    return new Promise(function(resolve){
      // WRAPPER > backdrop + panel, which is what the stylesheet describes.
      // .mg-modal-in is the PANEL, not an animation state - naming it as a
      // state here while the sheet styled it as the panel is what sized the
      // dialog to the viewport.
      var ov = document.createElement('div'); ov.className = 'mg-modal';
      var okClass = opts.danger ? ' mg-btn-danger' : ' mg-btn-primary';
      ov.innerHTML =
        '<div class="mg-modal-overlay"></div>' +
        '<div class="mg-modal-in">' +
          '<div class="mg-modal-msg"></div>' +
          (opts.prompt ? '<input class="mg-inp mg-modal-input" type="text">' : '') +
          '<div class="mg-modal-actions">' +
            '<button class="mg-btn mg-modal-cancel"></button>' +
            '<button class="mg-btn' + okClass + ' mg-modal-ok"></button>' +
          '</div>' +
        '</div>';
      var box = ov.querySelector('.mg-modal-in');
      box.querySelector('.mg-modal-msg').textContent = opts.msg || '';
      box.querySelector('.mg-modal-cancel').textContent = opts.cancel || 'Cancel';
      box.querySelector('.mg-modal-ok').textContent = opts.ok || 'OK';
      document.body.appendChild(ov);
      var input = box.querySelector('.mg-modal-input');
      if (input) { input.value = (opts.value != null ? opts.value : ''); setTimeout(function(){ input.focus(); input.select(); }, 30); }
      requestAnimationFrame(function(){ ov.classList.add('mg-modal-shown'); });
      function onKey(e){
        if (e.key === 'Escape') close(opts.prompt ? null : false);
        else if (e.key === 'Enter') close(opts.prompt ? (input ? input.value : '') : true);
      }
      function close(val){
        document.removeEventListener('keydown', onKey);
        ov.classList.remove('mg-modal-shown');
        setTimeout(function(){ if (ov.parentNode) ov.parentNode.removeChild(ov); }, 200);
        resolve(val);
      }
      document.addEventListener('keydown', onKey);
      box.querySelector('.mg-modal-ok').onclick = function(){ close(opts.prompt ? (input ? input.value : '') : true); };
      box.querySelector('.mg-modal-cancel').onclick = function(){ close(opts.prompt ? null : false); };
      ov.addEventListener('click', function(e){ if (e.target === ov) close(opts.prompt ? null : false); });
    });
  }
  window.mgConfirm = function(msg, opts){ opts = opts || {}; return mgModal({ msg: msg, ok: opts.ok || 'Confirm', danger: opts.danger }); };
  window.mgPrompt  = function(msg, value){ return mgModal({ msg: msg, prompt: true, value: value, ok: 'OK' }); };

  // SM118 (lifted from config.md after a field report against the Nav editor):
  // shared unsaved-changes guard. A page with an explicit Save registers its
  // dirty state with one call - mgDirtyGuard.set(key, noteId) on first
  // modification, mgDirtyGuard.clear(key) on a successful save (or an explicit
  // discard). noteId names the page's "Unsaved changes" span, shown while
  // dirty. The single beforeunload below warns only while something is dirty,
  // so normal navigation is never nagged.
  window.mgDirtyGuard = (function(){
    var dirty = {}, notes = {};
    function refresh(key){
      var n = notes[key] ? document.getElementById(notes[key]) : null;
      if (n) n.style.display = dirty[key] ? '' : 'none';
    }
    window.addEventListener('beforeunload', function(e){
      for (var k in dirty) { if (dirty[k]) { e.preventDefault(); e.returnValue = ''; return; } }
    });
    return {
      set:     function(key, noteId){ dirty[key] = true; if (noteId) notes[key] = noteId; refresh(key); },
      clear:   function(key){ dirty[key] = false; refresh(key); },
      isDirty: function(key){ return !!dirty[key]; }
    };
  })();

  // SM109 phase 5: command palette (Ctrl/Cmd-K) - jump to a page or run a command.
  window.MG_DESTINATIONS = [
    { label: 'Site settings', url: '/manager' },
    { label: 'Files',      url: '/manager/files' },
    { label: 'Navigation', url: '/manager/nav' },
    { label: 'Appearance', url: '/manager/appearance' },
    { label: 'Plugin Manager', url: '/manager/plugins' },
    { label: 'Plugin Config',  url: '/manager/plugin-config' },
    { label: 'Users',      url: '/manager/users' },
    { label: 'Groups',     url: '/manager/groups' },
    { label: 'Sessions &amp; keys', url: '/manager/sessions' },
    { label: 'Cache',      url: '/manager/cache' },
    { label: 'Backups',    url: '/manager/backups' },
    { label: 'Audit log',  url: '/manager/audit' },
    [% IF enabled_plugins.stats %]{ label: 'Visitor statistics', url: '/manager/stats' },[% END %]
    { label: 'View site',  url: '/' },
    { label: 'Toggle dark mode', action: 'theme' },
    { label: 'Sign out',   url: '/cgi-bin/lazysite-auth.pl?action=logout' }
  ];
  window.mgPaletteOpen = function(){
    if (document.getElementById('mg-palette-ov')) return;
    var ov = document.createElement('div'); ov.id = 'mg-palette-ov'; ov.className = 'mg-palette-overlay';
    ov.innerHTML = '<div class="mg-palette"><input class="mg-palette-input" type="text" ' +
      'placeholder="Jump to a page or run a command…" aria-label="Command palette">' +
      '<div class="mg-palette-list" role="listbox"></div></div>';
    document.body.appendChild(ov);
    var input = ov.querySelector('.mg-palette-input');
    var list  = ov.querySelector('.mg-palette-list');
    var sel = 0, filtered = [];
    function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function render(){
      var q = (input.value || '').toLowerCase();
      filtered = window.MG_DESTINATIONS.filter(function(d){ return d.label.toLowerCase().indexOf(q) !== -1; });
      if (sel >= filtered.length) sel = Math.max(0, filtered.length - 1);
      list.innerHTML = filtered.length ? filtered.map(function(d, i){
        return '<div class="mg-palette-item' + (i === sel ? ' sel' : '') + '" data-i="' + i + '">' +
          '<span>' + esc(d.label) + '</span>' +
          (d.url ? '<span class="mg-palette-url">' + esc(d.url) + '</span>' : '') + '</div>';
      }).join('') : '<div class="mg-palette-empty">No matches</div>';
    }
    function go(d){ if (!d) return; close(); if (d.action === 'theme') { window.mgToggleTheme(); } else if (d.url) { location.href = d.url; } }
    function close(){ if (ov.parentNode) ov.parentNode.removeChild(ov); document.removeEventListener('keydown', onKey, true); }
    function onKey(e){
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(filtered.length - 1, sel + 1); render(); }
      else if (e.key === 'ArrowUp')   { e.preventDefault(); sel = Math.max(0, sel - 1); render(); }
      else if (e.key === 'Enter')     { e.preventDefault(); go(filtered[sel]); }
    }
    document.addEventListener('keydown', onKey, true);
    input.addEventListener('input', function(){ sel = 0; render(); });
    list.addEventListener('click', function(e){ var it = e.target.closest('.mg-palette-item'); if (it) go(filtered[+it.getAttribute('data-i')]); });
    ov.addEventListener('click', function(e){ if (e.target === ov) close(); });
    render(); input.focus();
  };
  document.addEventListener('keydown', function(e){
    if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); window.mgPaletteOpen(); }
  });

  (function(){
    var MGR_API = '/cgi-bin/lazysite-manager-api.pl';
    var tokenPromise = fetch(MGR_API + '?action=csrf-token', { credentials: 'same-origin' })
      .then(function(r){ return r.json(); })
      .then(function(d){ window.LAZYSITE_CSRF = (d && d.token) || ''; return window.LAZYSITE_CSRF; })
      .catch(function(){ window.LAZYSITE_CSRF = ''; return ''; });
    window.lazysiteCsrfReady = function(){ return tokenPromise; };

    var origFetch = window.fetch.bind(window);

    // SM445: SAY WHEN THE SESSION HAS EXPIRED.
    //
    // Reported from the field: "the submit button did nothing. i refreshed and
    // discovered session expired. i had no information to say that, it just
    // felt like it has failed."
    //
    // It did nothing because every page posts through a helper shaped
    // `fetch(...).then(function (r) { return r.json(); })` with no status
    // check and no .catch(). An expired session answers 401 with a non-JSON
    // body, so r.json() REJECTS, the rejection is unhandled, and the .then()
    // never runs - so neither the success branch NOR the error branch fires.
    // The pages have an error branch for this and it is unreachable, because
    // the failure happens before the branch is chosen.
    //
    // Fixed HERE rather than in the 96 call sites across 12 pages: they
    // already share this wrapper, and a fix in one place cannot be half-
    // applied. Pages need no change and keep whatever they do today.
    //
    // ONLY 401. A 403 is a permission decision with a real JSON body that the
    // pages already report properly, and treating it as an expiry would tell
    // an operator to sign in again over a refusal that signing in will not
    // change.
    // SM461: A NON-JSON BODY IS NOT MALFORMED DATA.
    //
    // SM445 fixed the 401 case here. The rest of that class did not go away: a
    // 500, an uncaught die, a proxy timeout page or a login redirect all answer
    // with HTML, and a caller doing `r.json()` gets "JSON.parse: unexpected
    // character at line 1 column 1" - which the page then shows as though the
    // DATA were broken. An operator reads that as "the history is corrupt" and
    // goes looking at their content, when what happened was a 500.
    //
    // mgJson() is what a caller should use instead of r.json(). It reports the
    // STATUS and what actually came back, so the message names the fault
    // rather than mis-attributing it. Offered rather than imposed: the pages
    // adopt it where a wrong diagnosis costs something, and nothing breaks
    // where they have not.
    window.mgJson = function (r) {
      var ct = ( r.headers && r.headers.get('content-type') ) || '';
      if ( r.ok && ct.indexOf('json') !== -1 ) return r.json();
      return r.text().then(function (body) {
        var snip = ( body || '' ).replace(/\s+/g, ' ').slice(0, 120);
        var what = r.ok ? 'the server answered with ' + ( ct || 'no content type' )
                        : 'the server answered ' + r.status + ' ' + ( r.statusText || '' );
        var e = new Error( what + ( snip ? ' - ' + snip : '' ) );
        e.mgStatus = r.status;
        throw e;
      });
    };

    var expiredShown = false;
    function noteExpiry(r) {
      if ( !r || r.status !== 401 || expiredShown ) return r;
      expiredShown = true;
      var msg = 'Your session has expired, so that did not go through. '
              + 'Refresh the page and sign in again.';
      // The banner persists; a toast would fade while the operator was still
      // wondering whether the click registered.
      if ( window.mgShowWarning ) window.mgShowWarning(msg, true);
      var bar = document.getElementById('mg-warning-bar');
      if ( bar && !document.getElementById('mg-expired-reload') ) {
        var b = document.createElement('button');
        b.id = 'mg-expired-reload';
        b.className = 'mg-btn mg-btn-sm';
        b.textContent = 'Refresh now';
        b.onclick = function(){ location.reload(); };
        bar.appendChild(b);
      }
      return r;
    }

    window.fetch = function(resource, init){
      init = init || {};
      var method = (init.method || 'GET').toUpperCase();
      var url    = typeof resource === 'string' ? resource : (resource && resource.url) || '';
      if ( method !== 'POST' || url.indexOf(MGR_API) !== 0 ) {
        // GETs go through the same check: a page that loads its list after the
        // session lapsed is just as silent as one that submits.
        return origFetch(resource, init).then(noteExpiry);
      }
      var h = new Headers(init.headers || {});
      var init2 = {};
      for ( var k in init ) { if ( init.hasOwnProperty(k) ) init2[k] = init[k]; }
      init2.headers = h;
      return window.lazysiteCsrfReady().then(function(token){
        if ( token && !h.has('X-CSRF-Token') ) h.set('X-CSRF-Token', token);
        return origFetch(resource, init2).then(noteExpiry);
      });
    };
  })();

  // SM113: operator notifications (poll-based). Badge shows the unread count;
  // opening the panel marks everything seen. Both endpoints are GET (CSRF-exempt;
  // the seen-marker is a harmless per-operator write).
  (function () {
    if (!document.getElementById('mg-notif')) return;
    var API = '/cgi-bin/lazysite-manager-api.pl';
    function nesc(s){ var d=document.createElement('div'); d.textContent=(s==null?'':String(s)); return d.innerHTML; }
    function nago(ts){ var s=Math.floor(Date.now()/1000-(ts||0)); if(s<60)return'just now'; if(s<3600)return Math.floor(s/60)+'m ago'; if(s<86400)return Math.floor(s/3600)+'h ago'; return Math.floor(s/86400)+'d ago'; }
    var notices = [];
    function setBadge(n){
      var b=document.getElementById('mg-notif-badge'); if(!b)return;
      if(n>0){b.textContent=n>99?'99+':n; b.hidden=false;} else {b.hidden=true;}
      // Grey bell when quiet; the emoji's own colour returns when unread.
      var btn=document.querySelector('#mg-notif .mg-notif-btn');
      if(btn) btn.classList.toggle('mg-notif-unread', n>0);
    }
    function load(){
      fetch(API + '?action=notices').then(function(r){return r.json();}).then(function(d){
        if (!d || !d.ok) {
          // No 'notifications' capability: remove the bell entirely.
          if (d && d.kind === 'forbidden') {
            var w = document.getElementById('mg-notif');
            if (w && w.parentNode) w.parentNode.removeChild(w);
          }
          return;
        }
        notices = d.notices || []; setBadge(d.unread || 0);
      }).catch(function(){});
    }
    window.mgToggleNotif = function(){
      var panel = document.getElementById('mg-notif-panel'); if (!panel) return;
      if (!panel.hidden) { panel.hidden = true; return; }
      panel.innerHTML = notices.length ? notices.map(function(n){
        var inner = '<div class="mg-notif-msg">' + nesc(n.message||'') + '</div>'
                  + '<div class="mg-notif-time">' + nesc(nago(n.ts)) + '</div>';
        return n.url ? '<a class="mg-notif-item" href="'+nesc(n.url)+'">'+inner+'</a>'
                     : '<div class="mg-notif-item">'+inner+'</div>';
      }).join('') : '<div class="mg-notif-empty">No notifications.</div>';
      panel.hidden = false;
      fetch(API + '?action=notices-seen').then(function(){ setBadge(0); }).catch(function(){});
    };
    document.addEventListener('click', function(e){
      var wrap=document.getElementById('mg-notif'), panel=document.getElementById('mg-notif-panel');
      if (wrap && panel && !panel.hidden && !wrap.contains(e.target)) panel.hidden = true;
    });
    load();
  })();

  // SM305: ONE way to name a principal, shared by every page that names one.
  //
  // Three pages grew three different controls for the same job: a real <select>
  // on Users, an <input list="..."> datalist on Groups, and a bare text box on
  // the Files section sheet. The strictness ran backwards - the loosest control,
  // which offered no suggestions and validated nothing, was the one governing
  // who may READ protected content, where a typo means the wrong people can see
  // it and nothing says so. Naming a person is one piece of functionality, so it
  // gets one control.
  //
  // A <select> is the choice because it cannot express a principal that does not
  // exist. A datalist suggests and still accepts anything typed over it, which
  // is the failure mode that matters here.
  //
  // Pages call mgSetPrincipals() once when their user/group lists load, then
  // mgPrincipalSelect() wherever a name is needed. Nothing here talks to the
  // API: the server re-validates every principal on write regardless, and this
  // is the affordance, not the enforcement.
  (function(){
    var USERS = [], GROUPS = [];

    window.mgSetPrincipals = function(users, groups) {
      USERS  = (users  || []).slice();
      GROUPS = (groups || []).slice();
    };

    function esc(s) {
      return String(s === null || s === undefined ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // The option list. `prefix` is the marker a page uses to distinguish a group
    // from a user in a single namespace - '@' on Files, '' on Groups, where a
    // nested group is named plainly. Sorted as one list rather than users-then-
    // groups, so a name is where the reader expects it alphabetically.
    // `only` narrows to one kind where a field accepts only one - Domains names
    // groups in allowed_groups and users in locked_users, and offering the wrong
    // kind there would suggest a choice the field cannot store.
    window.mgPrincipalOptions = function(opts) {
      opts = opts || {};
      var prefix = opts.groupPrefix === undefined ? '@' : opts.groupPrefix;
      var all = opts.only === 'groups' ? [] : USERS.slice();
      if (opts.only !== 'users') GROUPS.forEach(function(g) {
        if (opts.exclude && g === opts.exclude) return;   // a group cannot contain itself
        all.push(prefix + g);
      });
      if (opts.extra) opts.extra.forEach(function(e) { if (all.indexOf(e) < 0) all.push(e); });
      return all.sort().map(function(k) {
        var sel = (opts.selected && k === opts.selected) ? ' selected' : '';
        return '<option value="' + esc(k) + '"' + sel + '>' + esc(k) + '</option>';
      }).join('');
    };

    // A complete picker. `placeholder` is the empty first option, which doubles
    // as the control's label when it sits alone.
    window.mgPrincipalSelect = function(opts) {
      opts = opts || {};
      return '<select class="mg-inp mg-principal-pick' + (opts.cls ? ' ' + opts.cls : '') + '"'
        + (opts.id ? ' id="' + esc(opts.id) + '"' : '')
        + (opts.onchange ? ' onchange="' + esc(opts.onchange) + '"' : '')
        + (opts.style ? ' style="' + esc(opts.style) + '"' : '')
        + '>'
        + '<option value="">' + esc(opts.placeholder || '+ add person or @group…') + '</option>'
        + window.mgPrincipalOptions(opts)
        + '</select>';
    };

    // Whether a name is one the site actually knows. Pages that still accept a
    // typed name use this to refuse a stranger rather than storing it.
    window.mgIsPrincipal = function(name) {
      if (!name) return false;
      if (name.charAt(0) === '@') return GROUPS.indexOf(name.slice(1)) >= 0;
      return USERS.indexOf(name) >= 0 || GROUPS.indexOf(name) >= 0;
    };

    /* SM678: the rights editor, shared.
     *
     * These were inside files.md, rendered into a FILE's expander. They are
     * generic over an ACL - a set of principals with r/w - and a data table's
     * access IS an ACL, keyed lazysite/db/tables/<name>. So the Data page could
     * not offer an editor without a second copy of this markup, which is the
     * duplication this project removes on sight.
     *
     * MOVED, NOT REWRITTEN. The DOM is byte-for-byte what files.md produced -
     * same classes, same data attributes, same button order - so that page's
     * markup, CSS and tests are untouched and this is a relocation rather than
     * a redesign of a working editor.
     */
    window.mgRights = (function() {
      function esc(x) {
        return String(x == null ? '' : x)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      return {
        chip: function(name, r, w) {
          return '<span class="mg-chip" data-name="' + esc(name) + '">'
               + '<span class="mg-chip-name">' + esc(name) + '</span>'
               + '<button type="button" class="mg-chip-right ' + (r ? 'on' : 'off') + '" data-right="r" onclick="mgRights.toggle(this)" title="read">r</button>'
               + '<button type="button" class="mg-chip-right ' + (w ? 'on' : 'off') + '" data-right="w" onclick="mgRights.toggle(this)" title="write">w</button>'
               + '<button type="button" class="mg-chip-x" onclick="mgRights.remove(this)" title="remove">&times;</button>'
               + '</span>';
        },
        /* The union of the two lists, each chip carrying which rights it holds
         * and keeping the order they were first seen in. */
        build: function(acl) {
          var read = {}, write = {}, order = [];
          ((acl && acl.read)  || []).forEach(function(p) { if (!read[p] && !write[p]) order.push(p); read[p] = 1; });
          ((acl && acl.write) || []).forEach(function(p) { if (!read[p] && !write[p]) order.push(p); write[p] = 1; });
          var self = this;
          return order.map(function(p) { return self.chip(p, read[p], write[p]); }).join('');
        },
        toggle: function(btn) {
          var on = btn.className.indexOf('on') >= 0;
          btn.className = 'mg-chip-right ' + (on ? 'off' : 'on');
        },
        remove: function(btn) {
          var chip = btn.parentNode;
          chip.parentNode.removeChild(chip);
        },
        /* Read the chips back out of a container. Returns the two lists the
         * acl-set action takes; the CALLER supplies the owner and the path,
         * because those are properties of the thing being governed and not of
         * the editor. */
        collect: function(container) {
          var read = [], write = [];
          var chips = container.querySelectorAll('.mg-chip');
          for (var i = 0; i < chips.length; i++) {
            var name = chips[i].getAttribute('data-name');
            var on   = chips[i].querySelectorAll('.mg-chip-right.on');
            for (var j = 0; j < on.length; j++) {
              if (on[j].getAttribute('data-right') === 'r') read.push(name);
              if (on[j].getAttribute('data-right') === 'w') write.push(name);
            }
          }
          return { read: read, write: write };
        }
      };
    })();
  })();
  </script>
</head>
<body class="mg-body">

<header class="mg-header">
  <div class="mg-header-inner">
    <!-- SM-DS1: the mobile nav drawer toggle. Hidden on desktop by the sheet;
         on a phone it is the only route to the navigation, so it carries
         aria-expanded and aria-controls rather than relying on the icon. The
         old wrap-to-top nav rows are gone. -->
    <button type="button" class="mg-nav-burger" onclick="mgToggleNav()"
            aria-label="Navigation" aria-expanded="false" aria-controls="mg-sidebar">&#9776;</button>
    <a href="/" class="mg-brand">[% site_name || 'Site' %]</a>
    <button type="button" class="mg-palette-btn" onclick="mgPaletteOpen()" aria-label="Open command palette">
      <span>Jump to&hellip;</span><kbd>Ctrl K</kbd>
    </button>
    <div class="mg-header-tools">
      <button type="button" class="mg-theme-toggle" onclick="mgToggleTheme()" title="Toggle light / dark" aria-label="Toggle light / dark">&#9681;</button>
      [% IF authenticated %]
      <div class="mg-notif" id="mg-notif">
        <button type="button" class="mg-notif-btn" onclick="mgToggleNotif()" title="Notifications" aria-label="Notifications">&#128276;<span class="mg-notif-badge" id="mg-notif-badge" hidden>0</span></button>
        <div class="mg-notif-panel" id="mg-notif-panel" hidden></div>
      </div>
      <span class="mg-user">[% auth_name || auth_user %]</span>
      [% IF no_password %]
      <span class="mg-note mg-note-warn">
        &#9888; No password set.
        <a href="/manager/users">Set one</a>
      </span>
      [% END %]
      <a href="/cgi-bin/lazysite-auth.pl?action=logout" class="mg-signout">Sign out</a>
      [% END %]
      <a href="/manager" class="mg-brand">Lazysite Manager</a>
    </div>
  </div>
</header>

<div id="mg-warning-bar" class="mg-warning-bar" style="display:none">
  <span id="mg-warning-bar-msg"></span>
  <button onclick="mgClearWarning()" class="mg-warning-bar-close" aria-label="Dismiss">x</button>
</div>

<div class="mg-shell">
  <!-- Tap off the drawer to close it. Empty by design: a hit area, not
       content, and inert until the drawer is open. -->
  <div class="mg-scrim" onclick="mgToggleNav(0)"></div>
  <aside class="mg-sidebar" id="mg-sidebar">
    <nav class="mg-nav" aria-label="Manager navigation">
      <div class="mg-nav-group">Content</div>
      [% IF manager_caps.manage_content %]<a href="/manager/files" [% IF request_uri.match('^/manager/files') %]class="active" aria-current="page"[% END %]>Files</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="Read and write site content. To enable it, grant 'Content' to a group on the Groups page.">Files &#128274;</a>[% END %]
      [% IF manager_caps.manage_nav %]<a href="/manager/nav" [% IF request_uri.match('^/manager/nav') %]class="active" aria-current="page"[% END %]>Navigation</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="Edit the site navigation menu. To enable it, grant 'Navigation' to a group on the Groups page.">Navigation &#128274;</a>[% END %]
      [% IF manager_caps.manage_themes || manager_caps.manage_layouts %]<a href="/manager/appearance" [% IF request_uri.match('^/manager/(appearance|themes)') %]class="active" aria-current="page"[% END %]>Appearance</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="Choose themes and layouts. To enable it, grant 'Themes' or 'Layouts' to a group on the Groups page.">Appearance &#128274;</a>[% END %]
      <a href="/manager/plugins" [% IF request_uri.match('^/manager/plugins$') %]class="active" aria-current="page"[% END %]>Plugin Manager</a>
      <a href="/manager/plugin-config" [% IF request_uri.match('^/manager/plugin-config') %]class="active" aria-current="page"[% END %]>Plugin Config</a>
      <div class="mg-nav-group">Access</div>
      <a href="/manager/users" [% IF request_uri.match('^/manager/users') %]class="active" aria-current="page"[% END %]>Users</a>
      <a href="/manager/groups" [% IF request_uri.match('^/manager/groups') %]class="active" aria-current="page"[% END %]>Groups</a>
      <a href="/manager/sessions" [% IF request_uri.match('^/manager/sessions') %]class="active" aria-current="page"[% END %]>Sessions &amp; keys</a>
      <div class="mg-nav-group">System</div>
      <a href="/manager" [% IF request_uri == '/manager' || request_uri == '/manager/' || request_uri.match('^/manager/config') %]class="active" aria-current="page"[% END %]>Site settings</a>
      [% IF manager_caps.manage_domains %]<a href="/manager/domains" [% IF request_uri.match('^/manager/domains') %]class="active" aria-current="page"[% END %]>Domains</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="Serve additional domains from this instance. To enable it, grant 'Domains &amp; site packages' to a group on the Groups page.">Domains &#128274;</a>[% END %]
      <a href="/manager/cache" [% IF request_uri.match('^/manager/cache') %]class="active" aria-current="page"[% END %]>Cache</a>
      <a href="/manager/backups" [% IF request_uri.match('^/manager/backups') %]class="active" aria-current="page"[% END %]>Backups</a>
      [% IF manager_caps.audit %]<a href="/manager/audit" [% IF request_uri.match('^/manager/audit') %]class="active" aria-current="page"[% END %]>Audit log</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="Read the append-only audit trail. To enable it, grant 'Audit trail' to a group on the Groups page.">Audit log &#128274;</a>[% END %]
      [% IF enabled_plugins.data %][% IF manager_caps.manage_data %]<a href="/manager/data" [% IF request_uri.match('^/manager/data') %]class="active" aria-current="page"[% END %]>Data tables</a>[% ELSIF manager_caps.manage_users %]<a href="/manager/groups" style="opacity:0.55;font-style:italic" title="See and manage the site's data tables. To enable it, grant 'Data' to a group on the Groups page.">Data tables &#128274;</a>[% END %][% END %]
      [% IF enabled_plugins.stats %]<a href="/manager/stats" [% IF request_uri.match('^/manager/stats') %]class="active" aria-current="page"[% END %]>Visitor statistics</a>[% END %]
    </nav>
  </aside>
  <main class="mg-main">
    [%# Consistent page heading for every manager page, driven by front-matter
        title. Full-bleed pages (the editor) hide .mg-main h1 in their own CSS. %]
    [% IF page_title %]<h1 class="mg-page-title">[% page_title %]</h1>[% END %]
    [% content %]
  </main>
</div>

<footer class="mg-foot" style="text-align:center;padding:1rem;font-size:0.8rem;">
  <span id="mg-version">lazysite</span>
</footer>
<script src="/manager/assets/manager-chrome.js?v=[% lazysite_version %]" defer></script>

</body>
</html>
