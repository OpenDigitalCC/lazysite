[%# SM1043: built-in account component - change your own password. Use on /account:
      ::: account-password
      :::
    Posts to the `me-password` action through /assets/lazysite-account.js, with
    the current password (re-authentication on every change, SM1034 Q3). On
    success every OTHER session of the account is signed out; this one stays.
    The form is the engine's, not content: the native-forms rule (SM361) is for
    pages, and this posts to no form handler. A layout may override this file,
    keeping the data-ls-* attributes and the field names. -%]
<section class="lz-account lz-account-password" data-ls-account="password">
  <form class="lz-account-form" data-ls-form autocomplete="on">
    <input type="text" name="username" autocomplete="username" data-ls-field="user" hidden>
    <label for="lz-acct-current">Current password</label>
    <input type="password" id="lz-acct-current" name="current_password" required autocomplete="current-password">
    <label for="lz-acct-new">New password</label>
    <input type="password" id="lz-acct-new" name="new_password" required autocomplete="new-password" data-ls-minlength>
    <label for="lz-acct-confirm">New password again</label>
    <input type="password" id="lz-acct-confirm" name="confirm_password" required autocomplete="new-password">
    <p class="lz-account-hint" data-ls-field="policy"></p>
    <div class="lz-account-actions"><button type="submit">Change password</button></div>
  </form>
  <p class="lz-account-status" data-ls-status role="status" aria-live="polite"></p>
</section>
