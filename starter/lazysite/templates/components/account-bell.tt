[%# SM1034 phase 1b: built-in account component - your own notices. Use on /account:
      ::: account-bell
      :::
    Lists the notices addressed to the signed-in account (`me-notices`) - a
    notification rule's per-member bell - and marks them read or dismisses them
    (`me-notices-seen`) through /assets/lazysite-account.js. Never the site's
    broadcast notices, which are the operators'. Messages and links go in as
    text and are checked to be http(s) or site paths. A layout may override this
    file, keeping the data-ls-* attributes. -%]
<section class="lz-account lz-account-bell" data-ls-account="bell">
  <p class="lz-account-count" data-ls-field="unread"></p>
  <ul class="lz-account-notices" data-ls-rows></ul>
  <p data-ls-empty hidden>Nothing for you yet.</p>
  <div class="lz-account-actions"><button type="button" data-ls-mark-all>Mark all read</button></div>
  <p class="lz-account-status" data-ls-status role="status" aria-live="polite"></p>
</section>
