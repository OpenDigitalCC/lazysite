# An example of YOUR proxy in front of the lazysite container (SM1361, ruling
# 205): it terminates TLS and passes every site's requests to the container's
# plain-HTTP port, keeping the Host header, which is how the container picks
# the site. Nothing in the recipe reads this file; adapt it to your proxy and
# certificates. Shown for nginx; any proxy that keeps Host and appends the
# client's address to X-Forwarded-For will do.
#
# The container publishes 127.0.0.1:8080 by default (compose.yaml), so this
# proxy runs on the same host. Set each site's trusted_proxies for it (the
# trusted_proxies note in docs/OPERATOR.md).

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # Every name the container's sites.conf lists, or a wildcard covering them.
    server_name example.com www.example.com *.sites.example.net;

    ssl_certificate     /etc/ssl/certs/sites.example.net.pem;
    ssl_certificate_key /etc/ssl/private/sites.example.net.key;

    client_max_body_size 64m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 150s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com *.sites.example.net;
    return 301 https://$host$request_uri;
}
