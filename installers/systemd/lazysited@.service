# lazysited@.service - the lazysite persistent runtime, one per instance
# (SM666 phase 1). Instance name = the site, normally its domain, the same
# convention as lazysite@.service:
#   systemctl enable --now lazysited@example.com.timer
#
# SM757: ONE UNIT FOR BOTH INSTALL FLOWS. The deb ships this into
# /usr/lib/systemd/system and its engine lives at /usr/share/lazysite - the
# Environment= default below. The tarball flow's per-site deploy
# (installers/hestia/lazysite-hestia-deploy.sh, root) installs the same file
# into /etc/systemd/system and writes ENGINE=<domain root> into the conf, so the
# runtime runs from the SITE's own tools/ and lib/ - the tarball has no host
# payload. EnvironmentFile= overrides Environment=, which is the mechanism.
#
# AND A TIMER (lazysited@.timer) beside it, because the manager has no root: a
# sysop enabling the plugin cannot start this unit, and a unit that exited 0
# for "disabled" is not restarted by Restart=on-failure. The timer re-runs the
# service every five minutes while it is inactive, so an enabled plugin is
# picked up within five minutes at the cost of one short-lived process per
# five minutes per disabled site - and nothing while it runs. Enable the TIMER;
# it starts the service.
#
# THE PATTERN IS lazysite@.service's, deliberately. Identity lives in
# /etc/lazysite/daemon/%i.conf (DOCROOT=, USER=) because systemd cannot
# template User= from an instance name and the instance name is a domain, not
# a Unix account. The unit starts the runtime as root, and lazysited.pl drops
# to USER before loading any daemon code. Unlike the pool there is nothing here
# that NEEDS root - phase 1 binds no socket - so root exists only long enough
# to become the site's user.
#
# THERE ARE TWO SWITCHES, AND THAT IS INTENDED.
#   1. This unit, enabled by the host operator.
#   2. The `daemon` plugin, enabled by the site's sysop in the manager.
# Both must be on for anything to run. The manager has no root, so enabling the
# plugin cannot start a service - and the runtime reports that honestly rather
# than pretending: `lazysited --docroot DIR --status` answers desired=on with
# verdict=inconsistent and a remedy naming this unit, which tells an
# operator exactly which of the two switches is missing (SM222's contract).
#
# ON A HOST WITH HUNDREDS OF SITES, the cost at rest is nothing. An
# uninstantiated unit does not exist; an instantiated one whose plugin is
# disabled exits immediately without creating so much as a state directory.
# What runs is the number of sites that have deliberately turned this on, not
# the number of sites installed.
#
# WHY Restart=on-failure AND NOT always, which is where this differs from the
# pool and the difference matters: a runtime whose plugin is disabled exits 0,
# on purpose. Under Restart=always systemd would restart it forever - a hot
# loop on every site that has the unit enabled and the plugin off, which is the
# common case. lazysited exits 0 for "disabled" and for a clean stop, and
# non-zero only for a real failure, so on-failure is correct for all three.

[Unit]
Description=lazysite persistent runtime (%i)
# There is no lazysite(1) man page and there never has been. systemd does not
# resolve Documentation= until something asks, so it sat here reading as a
# reference for years and `systemd-analyze verify` is what finally said so:
# "Command 'man lazysite(1)' failed with code 16". A pointer to a page that
# does not exist is worse than none - it tells an operator to stop looking.
Documentation=https://lazysite.io/docs/
After=network.target
ConditionPathExists=/etc/lazysite/daemon/%i.conf

# SM891: THE START LIMIT BELONGS HERE, AND LIVED IN [Service] WHERE SYSTEMD
# IGNORED IT.
#
# The supervisor's own restart handling covers a SERVICE dying; this covers the
# supervisor itself. A runtime that cannot start at all should not be retried
# tightly - the usual cause is configuration, which restarting will not fix.
#
# That reasoning was written down and has never been in force. These two keys
# moved to [Unit] in systemd 230 (2016), and in [Service] they are parsed,
# rejected and skipped: "Unknown key 'StartLimitIntervalSec' in section
# [Service], ignoring." So a runtime failing on a bad config has been retried
# every 5s for ever, with the rate limit that exists to stop it sitting four
# lines below the Restart= it was meant to bound.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/lazysite/daemon/%i.conf
Environment=ENGINE=/usr/share/lazysite
ExecStart=/usr/bin/perl ${ENGINE}/tools/lazysited.pl \
    --docroot ${DOCROOT} --user ${USER}
Restart=on-failure
RestartSec=5

# SEC-2026-07 (L-SYSTEMD), matching the pool: root is dropped inside the
# process, so these directives shrink the blast radius of the long-running
# child rather than impeding anything. ProtectSystem=full leaves /usr, /boot
# and /etc read-only; docroots live under /home|/var|/srv and stay writable,
# which the scheduler needs for its run records.
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
