# =========================================================================
# lazysite Apache vhost - FastCGI pool pattern
# Shipped by the lazysite-apache package; rendered to
# /etc/apache2/sites-available/<domain>.conf by lazysite-apache-vhost(1).
# Rendered as (domain, docroot, cgi-bin, port):
#   __DOMAIN__ __DOCROOT__ __CGIBIN__ __PORT__
#
# Pattern: static files are served directly; anonymous page traffic
# proxies to the persistent per-site lazysite@ pool socket (~150x faster
# on cache hits); the auth wrapper, manager and cgi-bin endpoints stay on
# the CGI path (they are not pooled - the pool is anonymous BY DESIGN,
# docs/architecture/performance.md).
#
# Needs: a2enmod cgid headers rewrite proxy proxy_fcgi
#        (+ include for overlaid SSI sites), and the pool itself:
#        /etc/lazysite/pools/__DOMAIN__.conf +
#        `systemctl enable --now lazysite@__DOMAIN__`
#        (see the lazysite-common README.Debian).
# HTTPS: this file is the port-80 vhost; `certbot --apache -d <domain>`
# derives the SSL vhost from it.
# Derived from the field-proven HestiaCP template (lazysite-fcgi.tpl)
# with the panel specifics removed. https://lazysite.io
# =========================================================================
<VirtualHost *:__PORT__>
    ServerName __DOMAIN__
    DocumentRoot __DOCROOT__

    # Strip client-supplied trust headers before any trusted component
    # sets them (docs/architecture/security.md "Apache config
    # requirement"): a client must never be able to smuggle an identity
    # past the auth wrapper. Needs mod_headers.
    RequestHeader unset X-Remote-User
    RequestHeader unset X-Remote-Groups
    RequestHeader unset X-Remote-Name
    RequestHeader unset X-Remote-Email
    RequestHeader unset X-Payment-Verified
    RequestHeader unset X-Payment-Payer

    # The site's cgi-bin (lazysite scripts + plugin endpoints). Needs
    # mod_cgid (or mod_cgi on a prefork MPM).
    ScriptAlias /cgi-bin/ __CGIBIN__/
    # SM070: WebDAV publishing endpoint - its own Basic auth, bypasses
    # the cookie auth wrapper. Stays CGI: DAV traffic is authenticated
    # per request, exactly what the pool does not do.
    ScriptAlias /dav __CGIBIN__/lazysite-dav.pl

    # Default processor target for the session carve-out below, so a
    # cgi-bin that is NOT the docroot's sibling still works. SetEnvIf
    # deliberately, not SetEnv: mod_env runs after mod_rewrite and would
    # clobber the [E=] override in the next rule; mod_setenvif runs
    # before, so the rewrite wins where it matters.
    SetEnvIf Request_URI "." LAZYSITE_PROCESSOR=__CGIBIN__/lazysite-processor.pl

    # Front the real cgi-bin scripts with the auth wrapper so the session
    # cookie becomes X-Remote-User before the target CGI runs
    # (security.md: "every /cgi-bin/*.pl passes through the auth
    # wrapper"). The wrapper execs LAZYSITE_PROCESSOR. Excludes auth.pl
    # itself (recursion); /dav does its own Basic auth. Needs mod_rewrite.
    RewriteEngine On
    RewriteRule ^/cgi-bin/(lazysite-(?:processor|manager-api)\.pl)$ /cgi-bin/lazysite-auth.pl [E=LAZYSITE_PROCESSOR:__CGIBIN__/$1,PT]

    CustomLog ${APACHE_LOG_DIR}/__DOMAIN__.access.log combined
    ErrorLog ${APACHE_LOG_DIR}/__DOMAIN__.error.log

    # index.html is deliberately NOT a DirectoryIndex: it is lazysite's
    # own page cache for the homepage, and serving it directly would
    # bypass the processor, so the per-request manager admin bar would
    # never appear on "/". With it removed, a lazysite markdown home
    # (index.md) falls through to the pool (or, with a session cookie,
    # the auth wrapper) - which serves the cache AND injects the bar. A
    # purely static index.html home (no index.md) is still served
    # directly by the rewrite below.
    DirectoryIndex index.htm index.shtml
    RewriteCond %{DOCUMENT_ROOT}/index.md   !-f
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^/$ /index.html [L]

    # SM133: migration fallback for clean URLs. A path with no Markdown
    # source but a static sibling is served directly - .shtml preferred
    # so Apache expands SSI includes (mod_include), else .html - keeping
    # a legacy pre-lazysite page intact until it is converted to
    # Markdown. Self-limiting: it fires only when the static sibling
    # exists and no .md does, so system paths (which have neither) are
    # untouched, and a .md source shadows it the moment it lands.
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.md    !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.shtml -f
    RewriteRule ^/([^.]+)$ /$1.shtml [L]
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.md   !-f
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
    RewriteRule ^/([^.]+)$ /$1.html [L]

    # SM248: the per-domain registries must reach the engine, ALWAYS.
    #
    # Every routing rule here is conditioned on the request mapping to NO file.
    # On a multi-domain instance $DOCROOT/sitemap.xml exists - it is the PRIMARY
    # site's - so a secondary domain's request matches a real file, skips every
    # rule below, and Apache serves the primary's sitemap, llms.txt and feeds
    # for the wrong Host. The engine has a correct per-Host handler (SM151 P6)
    # and it never runs, because the request never reaches it.
    #
    # This rule carries no -f condition, so it fires whether the file exists or
    # not. Placed BEFORE the cookie rule so it applies to crawler traffic (which
    # has no cookie) and to a logged-in operator alike. Self-maintaining: it
    # works for every domain, now and for any added later, with no vhost
    # regeneration.
    #
    # Hot assets (favicon.ico, images, CSS) are deliberately NOT routed here -
    # use `lazysite-apache-vhost rewrites` for those, which keeps them static.
    RewriteRule ^/(?:sitemap\.xml|llms\.txt|robots\.txt|feed\.rss|feed\.atom)$ \
        /cgi-bin/lazysite-auth.pl [PT,L]

    # Session-bearing requests stay on the CGI path: the pooled worker is
    # anonymous BY DESIGN (the auth wrapper's exec-per-request
    # trust-header model is not pooled - performance.md), so a request
    # carrying the lazysite_auth session cookie must go through the CGI
    # auth wrapper, which turns the cookie into X-Remote-User before the
    # processor runs. This is what makes /manager/ and the logged-in
    # admin bar work; only cookie-less visitor traffic - the hot path -
    # reaches the pool.
    RewriteCond %{HTTP_COOKIE} lazysite_auth=
    # Existing files (assets, static pages) keep being served directly,
    # session or not - mirrors what FallbackResource does for the pool
    # path.
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
    # /cgi-bin and /dav are handled by their ScriptAlias lines above;
    # keep them out of this rewrite (also breaks the rewrite-again loop
    # after PT).
    RewriteCond %{REQUEST_URI} !^/(?:cgi-bin|dav)(?:/|$)
    RewriteRule ^ /cgi-bin/lazysite-auth.pl [PT,L]

    # FastCGI pool (SM142/SM139): every remaining URL that maps to no
    # file falls through to this virtual path, and the <Location> below
    # hands it to the persistent per-site pool - lazysite@__DOMAIN__,
    # identity in /etc/lazysite/pools/__DOMAIN__.conf. The pooled
    # processor recovers the original URL from REDIRECT_URL/REQUEST_URI
    # (both survive the internal redirect), so no path information is
    # lost.
    FallbackResource /lazysite-pool
    <Location "/lazysite-pool">
        # Socket path = the lazysite@.service convention:
        # /run/lazysite/<instance>.sock with instance = the domain (see
        # the unit file and tools/lazysite-pool.pl). Needs mod_proxy +
        # mod_proxy_fcgi. A direct client request for /lazysite-pool just
        # reaches the processor as an unknown page (404) - harmless.
        SetHandler "proxy:unix:/run/lazysite/__DOMAIN__.sock|fcgi://localhost/"
    </Location>

    # The lazysite engine directory is never served raw (config, auth,
    # logs live under it).
    <Location /lazysite/>
        Require all denied
    </Location>
    # SM073: .brief sidecars document authoring intent and are never
    # public. FallbackResource only routes non-existent paths through, so
    # an existing .brief is otherwise served raw - deny it at the origin.
    <FilesMatch "\.brief$">
        Require all denied
    </FilesMatch>

    <Directory __DOCROOT__>
        # Debian's default config denies the filesystem outside
        # /var/www; grant the docroot explicitly (the Hestia original
        # inherited this from the panel).
        Require all granted
        AllowOverride None
        Options -Indexes +ExecCGI +IncludesNOEXEC
        # Server-Side Includes for an overlaid static (.shtml) site -
        # mod_include. Harmless for markdown-only sites (no .shtml
        # present).
        AddType text/html .shtml
        AddOutputFilter INCLUDES .shtml
    </Directory>
    <Directory __CGIBIN__>
        # Same Debian default-deny: the ScriptAlias target must be
        # granted or every CGI 403s.
        Require all granted
        AllowOverride None
        Options +ExecCGI
    </Directory>

    # Pass the Basic-auth Authorization header through to the CGIs
    # (Apache strips it by default); /dav's own authentication needs it.
    SetEnvIf Authorization .+ HTTP_AUTHORIZATION=$0
</VirtualHost>
