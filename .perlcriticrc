# lazysite Perl::Critic profile - the project's curated quality gate, enforced
# over the production scripts by t/lint/02-perlcritic.t.
#
# At SEVERITY 3 (review D2, 2026-07-02). The policies disabled below are
# DELIBERATELY excluded because lazysite's documented conventions differ from the
# Perl::Critic defaults, or because the policy over-fires on an idiom the code
# uses safely; everything else at severity 3 (and 4, 5) must pass. The severity-3
# move fixed the genuine findings it surfaced (unchecked opens folded into their
# -f guards; unused captures made non-capturing) - those policies stay ENABLED
# and now guard future code. See docs/architecture/code-quality.md.

severity = 3

# --- Regular expressions ---------------------------------------------------

# /x is required only on genuinely COMPLEX patterns (>= 60 chars) - short
# patterns stay clutter-free, per the house rationale. The complex ones (the
# access-log parser, the oembed/date/block patterns) carry /x.
[RegularExpressions::RequireExtendedFormatting]
minimum_regex_length_to_complain_about = 60

# Postfix-if guards the capture ( return $1 if $s =~ /.../ ), which this policy
# does not recognise as the required test - it over-fires on a safe idiom used
# throughout. Audited 2026-07-03: every flagged site uses the capture in the SAME
# statement as its match, guarded by a postfix if/while or a ternary on the match
# (auth/dav/mcp/processor/server + Plugins/Themes/form-handler) - none is
# genuinely unguarded.
[-RegularExpressions::ProhibitCaptureWithoutTest]

# The access-log parser and a few HTML-probe patterns are irreducibly long;
# they carry /x where over the threshold above. The complexity is inherent to
# what they match, not accidental.
[-RegularExpressions::ProhibitComplexRegexes]

# --- Error handling --------------------------------------------------------

# Many evals are deliberate best-effort ( eval { update_registries() } ) or use
# the return value AS the check ( my $ok = eval { ...; 1 } ). die goes to the
# log; a bare croak would not read better in a CGI. Kept narrow, not blanket.
[-ErrorHandling::RequireCheckingReturnValueOfEval]
[-ErrorHandling::RequireCarping]

# --- Subroutines / modules -------------------------------------------------

# `_`-prefixed helpers are exported (@EXPORT_OK) and used across modules; this
# policy sees only the declaring file and mis-reports them as unused.
[-Subroutines::ProhibitUnusedPrivateSubroutines]

# main() in the processor and the manager-API dispatch are single large
# if/elsif dispatchers - a documented, tested design (code-quality.md), not
# accidental complexity.
[-Subroutines::ProhibitExcessComplexity]
[-Modules::ProhibitExcessMainComplexity]
[-ControlStructures::ProhibitCascadingIfElse]

# A few handlers take many positional args by design (thin wrappers, request
# context). Reused lexical names are local and unambiguous in context.
[-Subroutines::ProhibitManyArgs]
[-Variables::ProhibitReusedNames]

# --- Variables -------------------------------------------------------------

# Module interface / configuration package vars ( $Lazysite::Auth::Acl::DOCROOT,
# our $DENY_REASON ) are a deliberate cross-script contract.
[-Variables::ProhibitPackageVars]

# `local $/;` (the slurp idiom) is intentional and reads correctly; requiring
# `local $/ = undef;` is noise.
[-Variables::RequireInitializationForLocalVars]

# --- I/O and control-flow idioms -------------------------------------------

# Backticks / qx are used deliberately in the tools and dev server to capture a
# child's output; the alternatives are heavier for no gain here.
[-InputOutput::ProhibitBacktickOperators]

# `unless ( !$x )` and friends read fine in the few places they appear.
[-ControlStructures::ProhibitNegativeExpressionsInUnlessAndUntilConditions]

# A couple of deeply-nested blocks and map/grep bodies are clearer inline than
# extracted; a conditional `use` loads an optional module.
[-ControlStructures::ProhibitDeepNests]
[-BuiltinFunctions::ProhibitComplexMappings]
[-BuiltinFunctions::ProhibitVoidGrep]
[-BuiltinFunctions::RequireSimpleSortBlock]
[-Modules::ProhibitConditionalUseStatements]

# 'left'/'right' etc. are unambiguous in their local context.
[-NamingConventions::ProhibitAmbiguousNames]

# ===========================================================================
# Inherited severity-4 deviations (unchanged - all still apply at severity 3).
# ===========================================================================

# `return undef` is the project idiom for a falsy scalar return (never used in
# list context); see docs/architecture/code-quality.md.
[-Subroutines::ProhibitExplicitReturnUndef]

# Self-contained CGIs end many subs with their last expression by design.
[-Subroutines::RequireFinalReturn]

# Encoding is handled explicitly (binmode / :utf8 where it matters); the blanket
# "open with an encoding layer" policy over-fires on the binary and control
# files (locks, rate DBs, the SBOM).
[-InputOutput::RequireEncodingWithUTF8Layer]

# File handles are intentionally held open across a read/write in several
# readers and writers.
[-InputOutput::RequireBriefOpen]

# Some subs read @_ directly (dispatchers, thin wrappers).
[-Subroutines::RequireArgUnpacking]

# Octal file modes are written 0640-style throughout.
[-ValuesAndExpressions::ProhibitLeadingZeros]

# CGIs read the request body from STDIN; $| and similar are set without local.
[-InputOutput::ProhibitExplicitStdin]
[-Variables::RequireLocalizedPunctuationVars]
[-InputOutput::ProhibitInteractiveTest]

# Narrow `no warnings 'category'` suppression is permitted and used deliberately
# (e.g. 'once' for a DB_File tie, 'uninitialized' for a log join). A BARE
# `no warnings` would still want review - keep it narrow.
[-TestingAndDebugging::ProhibitNoWarnings]
