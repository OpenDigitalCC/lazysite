#!/usr/bin/perl
# SM1125: nothing the engine ships calls a deprecated action spelling.
#
# Reported 2026-10-17 (0.15.9 walk, F-5): "The `plugin-save` / `plugin-read` /
# `plugin-action` spelling still works but is audited `spelling=deprecated`. My
# scripts use it; the manager page may too. Noted in case the deprecated
# spelling is due to go."
#
# The manager pages were already on `extension-*` (t/unit/manager/167 holds
# that), but the briefing a script author is given - served practice page - still taught `plugin-list` / `plugin-action`. That is where
# the reporter's scripts learned it. A spelling is only retired when nobody is
# being taught it, so the shipped docs, pages and assets are held to the new
# name here.
#
# THE DEPRECATED SET IS READ, NOT LISTED. lib/Lazysite/ControlApi/Actions.pm
# declares every action under its internal `plugin-*` name and the manager API
# treats exactly those as the deprecated spelling (its `\Aplugin-` test), so the
# set is that file's `plugin-*` keys. A hand-kept list would go stale the day an
# eighth verb is added.
#
# NOT SCANNED, and why: the served field-practice briefing is GENERATED by
# tools/import-field-practice.pl from the site agent's own files outside this
# repo (t/lint/89 forbids editing it here); it is recognised by the
# body-sha256 its import writes, and exempt until the source is changed and
# re-imported. The generated
# docs/reference/control-api-actions.md states that it lists the internal names.
# Audit-log wording elsewhere in the top-level docs quotes what the audit
# really records, which is still the canonical `plugin-*` name.
use strict;
use warnings;
use Test::More;
use FindBin;
use lib "$FindBin::Bin/../lib";
use File::Find;
use TestHelper qw(repo_root);

my $root = repo_root();

sub slurp {
    my ($f) = @_;
    open my $fh, '<:utf8', $f or return '';
    local $/;
    return scalar <$fh>;
}

my $actions = slurp("$root/lib/Lazysite/ControlApi/Actions.pm");
my @verbs = $actions =~ /^\s*'plugin-([a-z]+)'\s*=>/mg;
cmp_ok( scalar @verbs, '>=', 6, 'read the deprecated set from Actions.pm' );
my $alt = join '|', @verbs;

my @files;
for my $dir ( "$root/starter", "$root/skills" ) {
    next unless -d $dir;
    find(
        {   no_chdir => 1,
            wanted   => sub {
                return unless -f $_ && /\.(?:md|js|tt|html|json|txt|pl|sh)\z/;
                return if slurp($_) =~ /^\s*body-sha256:/m;
                push @files, $_;
            },
        },
        $dir
    );
}
cmp_ok( scalar @files, '>', 20, 'scanned the shipped pages, assets and docs' );

my @old;
for my $f ( sort @files ) {
    my $scan = slurp($f);

    # An element id is not an action: <div id="plugin-list">, getElementById.
    $scan =~ s/getElementById\(\s*['"][^'"]*['"]\s*\)//g;
    $scan =~ s/\bid\s*=\s*['"][^'"]*['"]//g;
    ( my $rel = $f ) =~ s{^\Q$root\E/}{};
    while ( $scan =~ /(?:action=|['"`\s(\/])plugin-($alt)\b(?!-)/g ) {
        my $verb = $1;
        my $at   = $-[0];
        my $line = 1 + ( () = substr( $scan, 0, $at ) =~ /\n/g );
        push @old, "$rel:$line plugin-$verb";
    }
}
is_deeply( \@old, [], 'no shipped page, asset or doc calls a deprecated action spelling' )
    or diag( join "\n", 'still on the old name:', @old );

done_testing();
