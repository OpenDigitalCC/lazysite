#!/usr/bin/perl
# SM1164 D1: THE EXTENSION WRITES THE SITE'S oomd.conf FROM ITS OWN CONFIG, 0600,
# BESIDE ITS SECRETS, LABELS ONLY.
#
# Inbox L7 addendum (2026-10-18), "The site's oomd.conf (generated by the extension,
# 0600)": `credentials = conn:/path/conn.key, grant-ana:/path/ana.key`; "A request
# names a label, never a path or a key." The filing's D1: the instance, the
# credentials as labels (`conn:`, `grant-<name>:`, and SM1161's scheduled keys),
# pack_dirs, cache_ttl_version, the socket (Q1) and `workers`, rewritten when the
# extension's config is saved and the daemon sent SIGHUP.
#
# No process is started here: the file is the thing. (t/unit/odoo/61 starts the real
# oomd on a file this code wrote.)
use strict;
use warnings;
use Test::More;
use File::Path qw(make_path);
use FindBin;
use lib "$FindBin::Bin/../../lib";
use lib "$FindBin::Bin/../../../lib";
use TestHelper qw(site_tempdir repo_root);
use OdooTest   qw(oom_or_skip write_conf set_key quiet);

BEGIN { oom_or_skip() }
use OdooDaemonTest qw(oomd_site);
use Lazysite::Odoo ();
use Lazysite::Odoo::Daemon ();

sub slurp { open my $fh, '<', $_[0] or return undef; local $/; <$fh> }

my $KEY = 'SECRET-KEY-VALUE-nobody-may-see';
my $d   = oomd_site( odoo_daemon_workers => 3, odoo_pack_dirs => '' );
$Lazysite::Odoo::DOCROOT = $d;
OdooTest::set_key( $d, $KEY );

subtest 'the settings: off by default, on, required, and nothing else' => sub {
    is_deeply( [ Lazysite::Odoo::Daemon::mode_from(undef) ],    [ 'off', '' ],      'unset is off' );
    is_deeply( [ Lazysite::Odoo::Daemon::mode_from('on') ],     [ 'on', '' ],       'on' );
    is_deeply( [ Lazysite::Odoo::Daemon::mode_from('Required') ], [ 'required', '' ], 'required' );
    my ( $m, $why ) = Lazysite::Odoo::Daemon::mode_from('requried');
    ok( !defined $m, 'a typo for required is refused, not read as off' );
    like( $why, qr/odoo_daemon must be off, on or required, not 'requried'/, 'and named' );
    is_deeply( [ Lazysite::Odoo::Daemon::workers_from(undef) ], [ 4, '' ], 'workers default to 4' );
    ok( !defined( ( Lazysite::Odoo::Daemon::workers_from('0') )[0] ),   'zero workers refused' );
    ok( !defined( ( Lazysite::Odoo::Daemon::workers_from('65') )[0] ),  'and 65' );
    ok( !defined( ( Lazysite::Odoo::Daemon::workers_from('many') )[0] ), 'and a word' );

    my ( $c, $cwhy ) = Lazysite::Odoo::connection();
    ok( $c, 'the connection loads' ) or diag($cwhy);
    is( $c->{daemon},         'on', 'the connection carries the mode' );
    is( $c->{daemon_workers}, 3,    'and the workers' );
    write_conf( $d, odoo_url => 'https://odoo.example', odoo_db => 'local16', odoo_login => 'tester', odoo_daemon => 'sometimes' );
    my ( $bad, $bwhy ) = Lazysite::Odoo::connection();
    ok( !$bad, 'a config with a bad odoo_daemon does not load' );
    like( $bwhy, qr/odoo_daemon/, 'and names the setting' );
};

write_conf( $d,
    odoo_url => 'https://odoo.example', odoo_db => 'local16', odoo_login => 'tester',
    odoo_allow_writes => 'true', odoo_packs => 'Odoo::Test::OomdOps', odoo_daemon => 'on', odoo_daemon_workers => 3,
    odoo_timeout => 20, odoo_max_kb => 64 );

subtest 'the conf is written 0600 with labels and no key' => sub {
    my $w = Lazysite::Odoo::Daemon::write_conf($d);
    ok( $w->{ok} && $w->{changed}, 'written' ) or diag explain $w;
    my $path = Lazysite::Odoo::Daemon::conf_path($d);
    is( $w->{path}, $path, 'beside the extension\'s secrets (lazysite/odoo/)' );
    like( $path, qr{/lazysite/odoo/oomd\.conf\z}, 'in the odoo store' );
    is( sprintf( '%04o', ( stat $path )[2] & 07777 ), '0600', 'mode 0600' );
    my $t = slurp($path);
    like( $t, qr/^url = https:\/\/odoo\.example$/m, 'the instance: url' );
    like( $t, qr/^db = local16$/m, 'and db' );
    like( $t, qr/^login = tester$/m, 'and the connection login' );
    like( $t, qr/^timeout = 20$/m, 'the timeout' );
    like( $t, qr/^max_response_bytes = 65536$/m, 'the size limit, in bytes' );
    like( $t, qr/^allow_writes = 1$/m, 'writes as the extension says' );
    like( $t, qr/^workers = 3$/m, 'workers from odoo_daemon_workers' );
    like( $t, qr/^cache_ttl_version = 300$/m, 'a module installed in Odoo is seen within 300 s' );
    like( $t, qr/^runs_dir = \S+\/lazysite\/odoo\/runs$/m, 'runs in the store' );
    my ($sock) = Lazysite::Odoo::Daemon::socket_for($d);
    like( $t, qr/^socket = \Q$sock\E$/m, 'the socket' );
    like( $t, qr/^credentials = conn:\S+\/odoo\/keys\/connection\.key$/m, 'the connection user is the label conn: with the key FILE' );
    unlike( $t, qr/\Q$KEY\E/, 'the key itself is nowhere in it' );
    unlike( $t, qr/api_key|password/i, 'and no inline credential key' );
};

subtest 'a grant\'s and a scheduled binding\'s own accounts are labels too' => sub {
    OdooTest::bind( $d, id => 'nightly', operation => 'oomd.pid', modes => 'scheduled' );
    my $g = Lazysite::Odoo::action_odoo_secret_set( 'GRANT-KEY-VALUE', grant => 'ana', login => 'ana@example.com' );
    ok( $g->{ok}, 'a grant account is set' ) or diag explain $g;
    my $s = Lazysite::Odoo::action_odoo_secret_set( 'SCHED-KEY-VALUE', scheduled => 'nightly', login => 'job@example.com' );
    ok( $s->{ok}, 'and a scheduled one' ) or diag explain $s;
    my $t = slurp( Lazysite::Odoo::Daemon::conf_path($d) );
    like( $t, qr/grant-[0-9a-f]{16}:ana\@example\.com:\S+\/keys\/grant-[0-9a-f]{16}\.key/, 'the grant: label, login, key file' );
    like( $t, qr/sched-[0-9a-f]{16}:job\@example\.com:\S+\/keys\/sched-[0-9a-f]{16}\.key/, 'the scheduled account: its label, login, key file' );
    unlike( $t, qr/GRANT-KEY-VALUE|SCHED-KEY-VALUE|\Q$KEY\E/, 'no key value in the file' );
    Lazysite::Odoo::action_odoo_secret_clear( scheduled => 'nightly' );
    unlike( slurp( Lazysite::Odoo::Daemon::conf_path($d) ), qr/sched-/, 'clearing a key removes its label (the config is rewritten)' );
};

subtest 'the socket: under the site when short, oomd\'s default directory when not' => sub {
    my ( $sock, $in ) = Lazysite::Odoo::Daemon::socket_for($d);
    is( $in, 'site', 'a short site path keeps its socket under the site' );
    like( $sock, qr{/lazysite/run/oomd\.sock\z}, 'as lazysite/run/oomd.sock' );
    cmp_ok( length $sock, '<', 104, 'under the 104 bytes of a Unix socket' );

    my $deep = site_tempdir();
    my $long = "$deep/" . join( '/', ('x' x 20) x 5 );
    make_path($long);
    my ( $lsock, $lin ) = Lazysite::Odoo::Daemon::socket_for($long);
    is( $lin, 'default', 'a site path that would overrun the limit uses the default directory' );
    like( $lsock, qr{\A/tmp/oomd-\d+/[A-Za-z0-9_.-]+\.sock\z}, 'which is oomd\'s /tmp/oomd-<uid>/<name>.sock' );
    cmp_ok( length $lsock, '<', 104, 'and is short enough' );
    like( $lsock, qr/\Q@{[ Lazysite::Odoo::Daemon::name($long) ]}\E\.sock\z/, 'named for the site' );
    isnt( Lazysite::Odoo::Daemon::name($long), Lazysite::Odoo::Daemon::name($d), 'two sites never share a name' );
};

subtest 'a config save rewrites the conf (the on_save hook), and off removes it' => sub {
    require Lazysite::Manager::Plugins;
    my $engine = repo_root();
    local $ENV{PERL5LIB} = join ':', "$engine/lib", $ENV{PERL5LIB} // ();
    {
        no warnings 'once';
        local $Lazysite::Manager::Plugins::DOCROOT = $d;
        local $Lazysite::Manager::Common::DOCROOT  = $d;
        my $before = slurp( Lazysite::Odoo::Daemon::conf_path($d) );
        my $r = Lazysite::Manager::Plugins::action_plugin_save( undef, 'plugins/odoo.pl', { odoo_daemon_workers => '6' } );
        ok( $r->{ok}, 'the config saves' ) or diag explain $r;
        ok( $r->{hook} && $r->{hook}{ok}, 'and the hook ran' ) or diag explain $r;
        my $after = slurp( Lazysite::Odoo::Daemon::conf_path($d) );
        isnt( $after, $before, 'the conf was rewritten' );
        like( $after, qr/^workers = 6$/m, 'from the saved config' );
        is( sprintf( '%04o', ( stat Lazysite::Odoo::Daemon::conf_path($d) )[2] & 07777 ), '0600', 'still 0600' );

        $r = Lazysite::Manager::Plugins::action_plugin_save( undef, 'plugins/odoo.pl', { odoo_daemon => 'off' } );
        ok( $r->{ok}, 'saving odoo_daemon: off' );
        ok( !-e Lazysite::Odoo::Daemon::conf_path($d), 'removes the conf: nothing that names key files stays when the daemon is off' );
    }
};

done_testing();
