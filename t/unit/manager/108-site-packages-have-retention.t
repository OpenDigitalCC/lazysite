#!/usr/bin/perl
# SM547: backup_retention bounds manual and prerestore snapshots (SM268
# 03-F11) and its helper's comment lists site packages too - but nothing
# ever called it for them, so an agent looping site_backup filled the disk
# with the artefact it produces most. Found by the backups structural review
# (N5), proven by probe tmp/bp-probe-site-retention.t.
#
# Retention is per HOST: on a shared instance, packaging one domain must not
# expire another domain's packages.
use strict;
use warnings;
use Test::More;
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use FindBin;
use lib "$FindBin::Bin/../../lib";
use lib "$FindBin::Bin/../../../lib";
use Lazysite::Manager::SitePackage qw(package_create);

sub spit { open my $fh, '>', $_[0] or die $!; print {$fh} $_[1]; close $fh }

my $d = tempdir( CLEANUP => 1 );
make_path( "$d/lazysite", "$d/sites/a", "$d/sites/b" );

sub conf {
    my ($keep) = @_;
    spit( "$d/lazysite/lazysite.conf",
        "site_name: Agency\nbackup_retention: $keep\n"
            . "alias_hosts: a.example, b.example\n"
            . "alias.a.example.content_root: sites/a\n"
            . "alias.b.example.content_root: sites/b\n" );
}
spit( "$d/sites/a/index.md", "# A\n" );
spit( "$d/sites/b/index.md", "# B\n" );
$Lazysite::Manager::SitePackage::DOCROOT = $d;
my $bk = "$d/lazysite/backups";

sub packages {
    my ($host) = @_;
    my @p = sort glob "$bk/lazysite-site-$host-*.tar.gz";
    return @p;
}

subtest 'backup_retention: 1 leaves one site package, the newest' => sub {
    conf(1);
    my $b = package_create('b.example');
    ok( $b->{ok}, 'another host has a package first' );
    my @names;
    for my $n ( 1 .. 3 ) {
        my $r = package_create('a.example');
        is( $r->{ok}, 1, "package $n ok" ) or diag explain $r;
        push @names, $r->{name};
        sleep 1;    # distinct mtimes, so "newest" is well defined
    }
    my @site = packages('a.example');
    is( scalar @site, 1, 'one package remains for the host' ) or diag "@site";
    is( $site[0],     "$bk/$names[-1]", 'and it is the newest one' );
    ok( -f "$bk/$names[-1].sha256", 'with its sidecar' );
    is( scalar( packages('b.example') ), 1, "the other host's package is untouched" );
};

subtest 'backup_retention: 0 is unlimited' => sub {
    conf(0);
    unlink glob "$bk/lazysite-site-*";
    for my $n ( 1 .. 3 ) {
        my $r = package_create('a.example');
        is( $r->{ok}, 1, "package $n ok" );
    }
    is( scalar( packages('a.example') ), 3, 'all three remain' );
};

done_testing;
