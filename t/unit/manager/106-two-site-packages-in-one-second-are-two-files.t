#!/usr/bin/perl
# SM545: a create that reports success has to leave behind the artefact it
# reported. package_create named the package host + a one-second stamp and
# wrote it with tar czf, which overwrites - so two creates in one second
# were two successes and one file, the first silently replaced and the
# sidecar describing whichever won. Found by the backups structural review
# (N2), proven by probe tmp/bp-probe-package-name.t. The O_EXCL claim that
# SM268 03-F9 gave manual/prerestore snapshots is now the package's too.
use strict;
use warnings;
use Test::More;
use File::Path qw(make_path);
use File::Temp qw(tempdir);
use FindBin;
use lib "$FindBin::Bin/../../lib";
use lib "$FindBin::Bin/../../../lib";
use Lazysite::Manager::SitePackage qw(package_create);
use Lazysite::Manager::Backups     ();

sub spit { open my $fh, '>', $_[0] or die $!; print {$fh} $_[1]; close $fh }

sub members {
    my ($path) = @_;
    open my $fh, '-|', 'tar', 'tzf', $path or die "tar: $!";
    my @m = <$fh>;
    close $fh;
    chomp @m;
    return @m;
}

my $d = tempdir( CLEANUP => 1 );
make_path( "$d/lazysite", "$d/sites/a" );
spit( "$d/lazysite/lazysite.conf",
    "site_name: Agency\nalias_hosts: a.example\nalias.a.example.content_root: sites/a\n" );
spit( "$d/sites/a/index.md", "# A\n" );
$Lazysite::Manager::SitePackage::DOCROOT = $d;
my $bk = "$d/lazysite/backups";

subtest 'two creates in one second are two names and two files' => sub {
    my ( $r1, $r2 );
    for my $try ( 1 .. 5 ) {
        unlink glob "$bk/lazysite-site-*";
        unlink "$d/sites/a/second.md";
        my $t0 = time;
        $r1 = package_create('a.example');
        spit( "$d/sites/a/second.md", "# second\n" );    # the second package differs
        $r2 = package_create('a.example');
        last if time == $t0;
    }
    is( $r1->{ok}, 1, 'first create ok' )  or diag explain $r1;
    is( $r2->{ok}, 1, 'second create ok' ) or diag explain $r2;
    isnt( $r1->{name}, $r2->{name}, 'the two successes name two different packages' );
    my @files = sort glob "$bk/lazysite-site-*.tar.gz";
    is( scalar @files, 2, 'two tarballs on disk for two successful creates' )
        or diag "@files";
    ok( -f "$bk/$r1->{name}" && -f "$bk/$r2->{name}", 'each named file exists' );
    ok( !( grep { $_ eq './content/second.md' } members("$bk/$r1->{name}") ),
        'the first package is the first snapshot (no second.md)' );
    ok( ( grep { $_ eq './content/second.md' } members("$bk/$r2->{name}") ),
        'the second package is the second' );
    is( Lazysite::Manager::Backups::verify_sha256("$bk/$r1->{name}"), 'verified',
        'the first sidecar describes the first package' );
    is( Lazysite::Manager::Backups::verify_sha256("$bk/$r2->{name}"), 'verified',
        'and the second the second' );
};

subtest 'a create that fails leaves no package behind' => sub {
    unlink glob "$bk/lazysite-site-*";
    my $r = package_create( 'a.example', data_tables => ['no-such-table'] );
    is( $r->{ok}, 0, 'a named table that does not exist fails the package' );
    my @left = glob "$bk/lazysite-site-*";
    is( scalar @left, 0, 'and nothing was left in the backups directory' )
        or diag "@left";
};

done_testing;
